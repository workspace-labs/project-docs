          "type": "start",
          "lane": "AI",
          "title": "Document chosen"
        },
        {
          "id": "ask",
          "type": "step",
          "lane": "AI",
          "title": "Asks up to 3 questions",
          "detail": "click answers + Other"
        },
        {
          "id": "answer",
