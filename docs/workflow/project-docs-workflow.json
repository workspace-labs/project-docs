{
  "project": {
    "name": "project-docs Skill",
    "accent": "project-docs",
    "client": "Everyone (public skill)",
    "date": "2026-11-23",
    "version": "0.15",
    "summary": "project-docs prepares a project's documents from the first client meeting to the handover plan: what we build and why (PRD), what it is built with (TRD), the look, the data, security, the handover and the step-by-step plan. After the project is handed over, it keeps the maintenance record.",
    "actors": [
      {
        "name": "Developer",
        "role": "Uses the skill for a project, answers the questions and decides."
      },
      {
        "name": "AI",
        "role": "Asks, reads back, writes each document and keeps the locks."
      },
      {
        "name": "Client",
        "role": "Approves each document or asks for changes. Can be the developer."
      },
      {
        "name": "Project files",
        "role": "The docs/ folder and DESIGN.md: the one place the truth lives."
      },
      {
        "name": "Builder",
        "role": "The agent or person that builds from the approved plan."
      },
      {
        "name": "frameflow skill",
        "role": "Draws the app flow (the screens), if installed."
      },
      {
        "name": "Check runner",
        "role": "Whoever runs a maintenance visit's checks. Never project-docs."
      }
    ],
    "assumptions": [
      "Order: PRD, TRD, app flow offer, Design, Data, Security, Handover, Plan.",
      "English by default; full right-to-left Arabic when the developer asks.",
      "A project built for oneself skips the meeting form, the Handover and the delivery steps.",
      "The AI never installs anything and never adds the agent instructions without a yes.",
      "frameflow not installed: the AI mentions it once with its link, then goes on to Design.",
      "project-docs writes and records. It never builds, runs a test or runs a visit's checks.",
      "Small offers are not drawn: the plan as a PDF and the closing builder handoff."
    ],
    "open_questions": []
  },
  "parts": [
    {
      "title": "Start: where are we?",
      "summary": "The AI reads what the project already has. A maintenance record is read first.",
      "lanes": [
        "Developer",
        "AI"
      ],
      "nodes": [
        {
          "id": "start",
          "type": "start",
          "lane": "Developer",
          "title": "Opens the project"
        },
        {
          "id": "read",
          "type": "step",
          "lane": "AI",
          "title": "Reads the project folder",
          "detail": "docs/, DESIGN.md, the code",
          "result": "What already exists"
        },
        {
          "id": "rec",
          "type": "decision",
          "lane": "AI",
          "title": "Has a record?",
          "detail": "a maintenance record",
          "branches": [
            {
              "label": "No",
              "to": "has"
            },
            {
              "label": "Yes",
              "to": "due"
            }
          ]
        },
        {
          "id": "due",
          "type": "step",
          "lane": "AI",
          "title": "Reports visits due",
          "detail": "soon or late, said first",
          "next": "has"
        },
        {
          "id": "has",
          "type": "decision",
          "lane": "AI",
          "title": "Has documents?",
          "branches": [
            {
              "label": "No",
              "to": "new"
            },
            {
              "label": "Yes",
              "to": "next"
            }
          ]
        },
        {
          "id": "new",
          "type": "end",
          "lane": "AI",
          "title": "New project",
          "to_part": 2
        },
        {
          "id": "next",
          "type": "end",
          "lane": "AI",
          "title": "Continues",
          "detail": "first one not approved",
          "to_part": 3
        }
      ]
    },
    {
